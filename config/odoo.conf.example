# Example for reference / manual copy outside of Docker.
# In Docker, odoo.conf is generated at startup by docker/odoo/docker-entrypoint.sh
# based on the variables in the .env file (see .env.example).

[options]
addons_path = /mnt/extra-addons
admin_passwd = change-me-master-password
data_dir = /var/lib/odoo
db_host = db
db_port = 5432
db_user = odoo
db_password = change-me-database-password
