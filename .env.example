# PostgreSQL (service db + webapp PG* + Odoo db_* generation)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres

# Odoo (injected in odoo.conf at container startup — no hard values in the repo)
# List separated by commas: custom addons + official Odoo addons (paths in the image)
ODOO_ADDONS_PATH=/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
# Master password « Manage databases » (to protect like a strong secret)
ODOO_ADMIN_PASSWD=change-me-master-password

# FastAPI / integration
ODOO_URL=http://odoo:8069
