# PostgreSQL (webapp PG* + Odoo via odoo.conf)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=odoo
# Use single-quoted values if the password contains $, #, or spaces.
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres

ODOO_ADDONS_PATH=/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
ODOO_ADMIN_PASSWD=change-me-master-password

ODOO_URL=http://odoo:8069
ODOO_DATABASE=postgres
ODOO_LOGIN=admin
ODOO_PASSWORD=change-me-odoo-user-password

# DATABASE_URL=postgresql+psycopg://odoo:password@db:5432/postgres
