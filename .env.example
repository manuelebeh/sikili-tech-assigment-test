# Copy this file to .env. Defaults work out of the box for local review:
#   cp .env.example .env && docker compose up
# Single source of truth for the FastAPI app, Odoo and PostgreSQL.
# If you customize a password, quote it with single quotes when it contains $, # or spaces.

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=sikili

ODOO_ADDONS_PATH=/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
ODOO_ADMIN_PASSWD=admin
ODOO_INIT_MODULES=sale_management,account

# ODOO_URL is overridden to http://odoo:8069 inside docker-compose; keep localhost for host-only runs.
ODOO_URL=http://localhost:8069
ODOO_LOGIN=admin
ODOO_PASSWORD=admin

# Optional explicit override (otherwise built from PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE):
# DATABASE_URL=postgresql+psycopg://odoo:odoo@db:5432/sikili
