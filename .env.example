# PostgreSQL (db service + webapp PG* + Odoo db_* in generated odoo.conf)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=odoo
# Use single quotes if the password contains $, #, or spaces (otherwise Docker Compose may truncate).
POSTGRES_PASSWORD=change-me-strong-password
# Default database name created on first Postgres init. With a custom name, Postgres creates an empty DB only:
# initialize Odoo once: docker compose exec odoo odoo -d YOUR_DB_NAME -i base --stop-after-init
# (otherwise: empty DB -> 500 / missing ir_module_module / KeyError ir.http)
POSTGRES_DB=postgres

# Odoo (injected into odoo.conf at container startup — no secrets in the repo)
# Comma-separated: custom addons + official Odoo addons (paths inside the image)
ODOO_ADDONS_PATH=/mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
# Master password for "Manage databases" — same quoting rule if special characters.
ODOO_ADMIN_PASSWD=change-me-master-password

# FastAPI / integration
ODOO_URL=http://odoo:8069

# Optional: single URL for SQLAlchemy / Alembic (overrides PG* when set).
# DATABASE_URL=postgresql+psycopg://odoo:password@db:5432/postgres
